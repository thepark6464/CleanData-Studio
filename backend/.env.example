# CleanData API (FastAPI Backend) Environment Variables — Placeholders Only
ENVIRONMENT="development"
ALLOWED_ORIGIN="http://localhost:3000"

# Security & Signing
API_KEY_PEPPER="CHANGE_ME_RANDOM_HEX_PEPPER"
DOWNLOAD_SIGNING_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"
SIGNED_URL_TTL_SECONDS="300"

# Upload & Processing Limits
STORAGE_DIR="/tmp/cleandata_storage"
STORAGE_BUCKET="cleandata-private"
MAX_UPLOAD_MB_DEFAULT="25"
MAX_ROWS_DEFAULT="250000"
XLSX_MAX_UNCOMPRESSED_MB="50"
XLSX_MAX_ENTRIES="200"
RATE_LIMIT_PER_MIN="60"

# Retention Policy
INPUT_RETENTION_HOURS="24"
OUTPUT_RETENTION_DAYS="7"

# Phase 4+ Supabase & Database (optional until Phase 4)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Payments (Cashfree Payment Gateway & Subscriptions — backend-only, NEVER expose in VITE_*)
PAYMENT_PROVIDER="cashfree"
CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2025-01-01"
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
CASHFREE_WEBHOOK_SECRET="YOUR_CASHFREE_WEBHOOK_SECRET"

# Optional Error Reporting
SENTRY_DSN=""
